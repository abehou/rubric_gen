diff --git a/tests/test_pretreatment_reuse.py b/tests/test_pretreatment_reuse.py
index 5f2ec6b..264dd1f 100644
--- a/tests/test_pretreatment_reuse.py
+++ b/tests/test_pretreatment_reuse.py
@@ -149,3 +149,26 @@ def test_completed_validation_checks_producer_before_generation_or_provider(
     if identity != 'current-producer':
         assert 'before provider work' in str(error.value)
     assert {str(p): p.read_bytes() for p in tmp_path.rglob('*') if p.is_file()} == before
+
+
+def test_frozen_receipt_pins_source_and_consumer(tmp_path):
+    source = tmp_path / 'source'
+    producer = source / 'rubric-generations/generation-0001/evolution.json'
+    producer.parent.mkdir(parents=True)
+    producer.write_text('{"implementation_sha256":"original"}')
+    receipt = tmp_path / 'consumer' / 'receipt.json'
+    expected = reuse.input_receipt(source, consumer_id='new-study')
+    reuse.seal_input_receipt(receipt, expected)
+    before = receipt.read_bytes()
+    reuse.seal_input_receipt(receipt, expected)
+    assert receipt.read_bytes() == before
+    changed_consumer = reuse.input_receipt(source, consumer_id='other-study')
+    with pytest.raises(ValueError, match='changed since'):
+        reuse.check_input_receipt(receipt, changed_consumer)
+    producer.write_text('changed producer evidence')
+    with pytest.raises(ValueError, match='changed since'):
+        reuse.check_input_receipt(receipt, reuse.input_receipt(source, consumer_id='new-study'))
+    assert receipt.read_bytes() == before
+    (source / 'linked').symlink_to(producer)
+    with pytest.raises(ValueError, match='non-regular'):
+        reuse.input_receipt(source, consumer_id='new-study')
