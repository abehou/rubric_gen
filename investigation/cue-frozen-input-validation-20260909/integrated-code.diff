+++ b/src/rubric_gen/submission_revision/pretreatment_reuse.py
@@ -5,6 +5,8 @@ record is rewritten and no missing source rubric is generated implicitly.
 """
 from pathlib import Path
 import shutil
+from rubric_gen.artifacts.hashing import sha256_file
+from rubric_gen.artifacts.serialization import write_json_atomic
 
 from rubric_gen.runtime.yaml import load_yaml_strict
 from rubric_gen.submission_revision.artifacts import read_json_object
@@ -66,3 +68,36 @@ def copy_pool_entry(source: Path, destination: Path) -> None:
         return
     destination.parent.mkdir(parents=True, exist_ok=True)
     shutil.copytree(source, destination)
+
+
+def input_receipt(source: Path, *, consumer_id: str) -> dict:
+    """Describe the exact immutable input; native validation is still required."""
+    if source.is_symlink() or not source.is_dir():
+        raise ValueError('frozen pre-treatment input is not a regular directory')
+    files = {}
+    for path in sorted(source.rglob('*')):
+        if path.is_symlink() or not (path.is_dir() or path.is_file()):
+            raise ValueError('frozen pre-treatment input contains a non-regular entry')
+        if path.is_file():
+            files[str(path.relative_to(source))] = sha256_file(path)
+    evolution = 'rubric-generations/generation-0001/evolution.json'
+    if evolution not in files:
+        raise ValueError('frozen pre-treatment input lacks producer evidence')
+    return dict(kind='frozen-pretreatment-input-v1', consumer_id=consumer_id,
+                source=str(source.resolve()), source_files=files,
+                source_evolution_sha256=files[evolution])
+
+
+def check_input_receipt(path: Path, expected: dict) -> None:
+    if path.is_symlink():
+        raise ValueError('frozen input receipt is symlinked')
+    if path.exists() and read_json_object(path, 'frozen input receipt') != expected:
+        raise ValueError('frozen input changed since consumer validation')
+
+
+def seal_input_receipt(path: Path, expected: dict) -> None:
+    """Call only after native source validation, before copying into the study."""
+    check_input_receipt(path, expected)
+    if not path.exists():
+        path.parent.mkdir(parents=True, exist_ok=True)
+        write_json_atomic(path, expected)
