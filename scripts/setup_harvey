#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
experiment_file="${1:-$project_root/experiments/harvey-harness-evolution-dev3.yaml}"
harvey_repository="https://github.com/harveyai/harvey-labs.git"

mapfile -t harvey_config < <(
  uv run --project "$project_root" python -c '
import sys
from pathlib import Path

from rubric_gen.benchmarks.harvey_lab.config import load_experiment
from rubric_gen.benchmarks.harvey_lab.runtime import runtime_root_from_environment

experiment = load_experiment(Path(sys.argv[1]))
print(experiment.benchmark.checkout)
print(experiment.benchmark.revision)
print(experiment.cache_dir / experiment.benchmark.revision)
print(runtime_root_from_environment())
' "$experiment_file"
)

if [[ ${#harvey_config[@]} -ne 4 ]]; then
  echo "Could not read the Harvey checkout, revision, cache, and runtime root from $experiment_file" >&2
  exit 1
fi

harvey_checkout="${harvey_config[0]}"
harvey_revision="${harvey_config[1]}"
harvey_cache="${harvey_config[2]}"
harvey_runtime_root="${harvey_config[3]}"

if [[ ! -e "$harvey_checkout" ]]; then
  git clone "$harvey_repository" "$harvey_checkout"
  observed_revision="$(git -C "$harvey_checkout" rev-parse HEAD)"
  if [[ "$observed_revision" != "$harvey_revision" ]]; then
    pin_branch="rubric-gen-${harvey_revision:0:12}"
    git -C "$harvey_checkout" switch --create "$pin_branch" "$harvey_revision"
  fi
elif [[ ! -d "$harvey_checkout/.git" ]]; then
  echo "Harvey checkout path exists but is not a Git checkout: $harvey_checkout" >&2
  exit 1
fi

observed_revision="$(git -C "$harvey_checkout" rev-parse HEAD)"
if [[ "$observed_revision" != "$harvey_revision" ]]; then
  echo "Harvey checkout revision is $observed_revision; expected $harvey_revision" >&2
  echo "Use a separate clean checkout at the revision in $experiment_file." >&2
  exit 1
fi

if [[ -n "$(git -C "$harvey_checkout" status --porcelain --untracked-files=no)" ]]; then
  echo "Harvey checkout has tracked changes: $harvey_checkout" >&2
  exit 1
fi

echo "Harvey LAB checkout: $harvey_checkout"
echo "Harvey LAB revision: $harvey_revision"
echo "Harvey shared cache: $harvey_cache"
echo "Harvey runtime root: $harvey_runtime_root"
uv run --project "$project_root" python -c '
import subprocess
import sys
from pathlib import Path

from rubric_gen.benchmarks.harvey_lab.podman import (
    cache_image,
    configured_podman_environment,
    restore_cached_image,
)

setup = sys.argv[1]
cache_root = Path(sys.argv[2])
runtime_root = Path(sys.argv[3])
local_image = "lab-sandbox:latest"
remote_image = "ghcr.io/harveyai/lab-sandbox:latest"
environment = configured_podman_environment(
    cache_root=cache_root,
    runtime_root=runtime_root,
)
if restore_cached_image(
    environment,
    cache_root=cache_root,
    image=local_image,
):
    subprocess.run(
        ["podman", "tag", local_image, remote_image],
        env=environment,
        check=True,
    )
result = subprocess.run([setup], env=environment)
if result.returncode != 0:
    raise SystemExit(result.returncode)
archive = cache_image(
    environment,
    cache_root=cache_root,
    image=local_image,
)
print(f"Harvey shared image archive: {archive}")
' "$harvey_checkout/scripts/setup.sh" "$harvey_cache" "$harvey_runtime_root"
